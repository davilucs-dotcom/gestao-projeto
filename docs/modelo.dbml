// SGP IFPA — Gestão de Projetos (Ensino, Pesquisa e Extensão)
// Cole em https://dbdiagram.io para exportar PNG/PDF

Table usuarios {
  id int [pk, increment]
  nome varchar(120) [not null]
  email varchar(190) [unique, not null]
  matricula varchar(30) [unique, not null]
  senha_hash varchar(255) [not null]
  perfil varchar(20) [not null, note: 'Docente | Discente | Tecnico']
  criado_em timestamp [default: `CURRENT_TIMESTAMP`]
}

Table projetos {
  id int [pk, increment]
  titulo varchar(200) [not null]
  resumo text
  modalidade varchar(20) [not null, note: 'Ensino | Pesquisa | Extensao']
  coordenador_id int [not null, ref: > usuarios.id]
  data_inicio date [not null]
  data_fim date [not null]
  status varchar(20) [not null, default: 'Em andamento', note: 'Em andamento | Concluido | Suspenso']
  criado_em timestamp [default: `CURRENT_TIMESTAMP`]

  Note: 'Progresso calculado por vw_projetos_progresso. Vigência mínima de 7 dias (CHECK). Coordenador deve ser Docente (TRIGGER).'
}

Table equipes {
  id int [pk, increment]
  projeto_id int [not null, ref: > projetos.id]
  usuario_id int [not null, ref: > usuarios.id]
  papel varchar(20) [not null, note: 'Coordenador | Bolsista | Voluntario | Colaborador']
  carga_horaria_semanal tinyint [not null, default: 4, note: '1-40']
  data_entrada date [not null]

  indexes {
    (projeto_id, usuario_id) [unique]
  }
}

Table relatorios {
  id int [pk, increment]
  projeto_id int [not null, ref: > projetos.id]
  tipo varchar(20) [not null, note: 'Parcial | Final']
  data_limite date [not null]
  data_entrega date
  arquivo_path varchar(255)

  indexes {
    (projeto_id, tipo) [unique]
  }

  Note: 'Parcial = metade da vigência; Final = data_fim. Situação via view (Pendente/Entregue/Atrasado).'
}
